[Desktop Entry]
Type=Application
Name=Cloudar Browser
GenericName=Web Browser
Comment=A modern, lightweight Qt6/WebEngine browser
Exec=cloudar-browser %U
Icon=cloudar-browser
Terminal=false
Categories=Network;WebBrowser;
